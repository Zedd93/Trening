# Adres, pod którym aplikacja będzie dostępna:
#  - domena widoczna z internetu (np. trening.firma.pl) -> Caddy sam pobierze
#    certyfikat Let's Encrypt (porty 80 i 443 muszą być otwarte z internetu),
#  - serwer tylko w sieci firmowej -> wpisz nazwę lub IP z prefiksem https://
#    i dopisz w Caddyfile `tls internal` (patrz DEPLOY.md).
SITE_ADDRESS=trening.firma.pl

# --- Opcjonalnie: Supabase (wielu użytkowników, synchronizacja) -----------
# Zmiana tych wartości wymaga przebudowania: docker compose up -d --build
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Opcjonalnie: asystent AI --------------------------------------------
ANTHROPIC_API_KEY=
ASSISTANT_MODEL=claude-opus-5-5
ASSISTANT_ALLOW_LOCAL=false
