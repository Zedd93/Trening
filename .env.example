# --- Supabase (opcjonalnie) ---------------------------------------------
# Bez tych zmiennych aplikacja działa w trybie lokalnym (dane w IndexedDB
# na tym urządzeniu). Po ich ustawieniu włącza się logowanie Supabase Auth
# i synchronizacja z PostgreSQL chronionym przez Row Level Security.
# Klucz "anon" jest kluczem publicznym (bezpieczny po stronie klienta tylko
# dzięki RLS). NIGDY nie umieszczaj tu klucza service_role.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Asystent AI (opcjonalnie, tylko po stronie serwera) -----------------
# Klucz jest używany wyłącznie w trasie /api/assistant i nie trafia do przeglądarki.
ANTHROPIC_API_KEY=
ASSISTANT_MODEL=claude-opus-5-5
# W trybie lokalnym (bez Supabase) trasa AI jest wyłączona, chyba że:
ASSISTANT_ALLOW_LOCAL=false
